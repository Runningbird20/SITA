# Copy this file to .env and adjust as needed.
# No paid API keys are required anywhere in this project — the default
# LLM_PROVIDER below (mock) and the fully-local Ollama/LM Studio options
# need none. OPENAI_API_KEY/ANTHROPIC_API_KEY further down are optional,
# bring-your-own-key extras, never required for the app to run.

# --- General ---
ENVIRONMENT=development
LOG_LEVEL=INFO
LOG_FORMAT=json          # "json" | "console" (console is easier to read locally)

# --- Security (Phase 14) ---
# Empty (default) = no auth required — every quick-start command above
# works with zero setup. Set a real value to require
# `Authorization: Bearer <token>` on every /api/v1/* request (the
# frontend will prompt for it). /healthz and /metrics are never gated by
# this — see DEF.md § Phase 14.
API_AUTH_TOKEN=
# Requests per minute, per client IP. "Strict" covers ingestion
# (POST /api/v1/events/{source_type}) and the pipeline-trigger endpoint
# (POST /api/v1/pipeline/run); "general" covers every other /api/v1/* route.
RATE_LIMIT_GENERAL_PER_MINUTE=300
RATE_LIMIT_STRICT_PER_MINUTE=30
# Requests with a larger Content-Length are rejected with 413 before the
# body is read.
MAX_REQUEST_BODY_BYTES=10000000

# --- Postgres (used by docker-compose to configure the postgres service) ---
POSTGRES_USER=sita
POSTGRES_PASSWORD=sita
POSTGRES_DB=sita

# --- Backend database connection ---
# Local dev without Docker: point at SQLite for a zero-dependency start.
#   DATABASE_URL=sqlite:///./sita.db
# Via docker-compose, this is overridden to point at the postgres service —
# see docker-compose.yml. Set explicitly here only for native (non-Docker) runs.
DATABASE_URL=sqlite:///./sita.db

# --- LLM provider ---
# LLM_PROVIDER=mock lets the whole app run with zero LLM dependency —
# useful for CI and for development without any LLM backend installed.
#   "mock"       - canned responses, zero network calls (default)
#   "ollama"     - fully local, no key: https://ollama.com
#   "lm_studio"  - fully local, no key: https://lmstudio.ai (OpenAI-compatible
#                  server; set LM_STUDIO_MODEL to whatever you've loaded)
#   "openai"     - bring your own key, never required
#   "anthropic"  - bring your own key, never required
LLM_PROVIDER=mock
LLM_REQUEST_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2
LLM_RETRY_BACKOFF_SECONDS=0.2
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1024

# Ollama (fully local, no key). CyberCrew/notmythos-8b is the default —
# an 8B-class instruct model. Requires a real multi-gigabyte pull and
# meaningfully more RAM/CPU-time than a small model — see the README's
# "Enabling real AI triage" section for hardware tradeoffs before pulling.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=CyberCrew/notmythos-8b
# Raised above Ollama's own default (1.1) to curb small models looping on
# the same list item in structured JSON output (e.g. a repeated hypothesis
# or investigation step).
OLLAMA_REPEAT_PENALTY=1.3

# LM Studio (fully local, no key) — must match the model currently loaded
# in the LM Studio app; there's no sensible universal default.
LM_STUDIO_BASE_URL=http://localhost:1234/v1
LM_STUDIO_MODEL=

# OpenAI (bring your own key — leave empty unless you're using LLM_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic (bring your own key — leave empty unless you're using LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-20241022
ANTHROPIC_BASE_URL=https://api.anthropic.com

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8000
