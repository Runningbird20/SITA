# Copy this file to .env and adjust as needed.
# No paid API keys are required anywhere in this project.

# --- General ---
ENVIRONMENT=development
LOG_LEVEL=INFO
LOG_FORMAT=json          # "json" | "console" (console is easier to read locally)

# --- Postgres (used by docker-compose to configure the postgres service) ---
POSTGRES_USER=sita
POSTGRES_PASSWORD=sita
POSTGRES_DB=sita

# --- Backend database connection ---
# Local dev without Docker: point at SQLite for a zero-dependency start.
#   DATABASE_URL=sqlite:///./sita.db
# Via docker-compose, this is overridden to point at the postgres service —
# see docker-compose.yml. Set explicitly here only for native (non-Docker) runs.
DATABASE_URL=sqlite:///./sita.db

# --- Local LLM (Ollama) ---
# LLM_PROVIDER=mock lets the whole app run with zero LLM dependency —
# useful for CI and for development without Ollama installed.
LLM_PROVIDER=mock        # "ollama" | "mock"
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b-instruct-q4_K_M
LLM_REQUEST_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2
LLM_TEMPERATURE=0.2

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8000
