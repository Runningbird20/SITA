# TLS-terminating reverse proxy for the production deployment
# (docker-compose.prod.yml) — puts the frontend and backend behind one
# origin so the frontend can call the API with a plain relative path
# (no CORS, no separate VITE_API_BASE_URL to configure).
#
# Local/default: SITA_DOMAIN unset -> "localhost", and `tls internal`
# below makes Caddy mint and trust its own self-signed certificate —
# nothing to configure, works immediately against https://localhost.
#
# Real deployment: set SITA_DOMAIN to your actual hostname (DNS already
# pointed at this host, ports 80/443 reachable from the internet) and
# delete the `tls internal` line below — Caddy then requests and renews
# a real Let's Encrypt certificate for you automatically. That's the
# entire change; nothing else in this file needs to move.

{$SITA_DOMAIN:localhost} {
	tls internal

	# Everything the backend serves directly — API routes plus its own
	# non-API surfaces (health check, metrics, OpenAPI docs).
	@backend path /api/* /healthz /metrics /docs* /redoc* /openapi.json
	handle @backend {
		reverse_proxy backend:8000
	}

	# Everything else: the built React app (and its client-side routes —
	# frontend/nginx.conf's own try_files already falls back to
	# index.html for those).
	handle {
		reverse_proxy frontend:8080
	}
}
